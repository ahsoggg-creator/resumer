1 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION RS_MAJOR,RS_MINOR,RS_PATCH,0
PRODUCTVERSION RS_MAJOR,RS_MINOR,RS_PATCH,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041904B0"
    BEGIN
      VALUE "CompanyName", "Resumer"
      VALUE "FileDescription", "Resumer"
      VALUE "ProductName", "Resumer"
      VALUE "OriginalFilename", "Resumer.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x419, 1200
  END
END
